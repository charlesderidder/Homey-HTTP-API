  "flow": {
    "triggers": [
      {
        "title": {
          "en": "An HTTP API request is received",
          "de": "Eine HTTP-API-Anfrage wird empfangen",
          "nl": "Er is een HTTP API-verzoek ontvangen"
        },
        "titleFormatted": {
          "en": "A [[method]] request received on url [[url]]",
          "de": "Eine [[method]]-Anfrage mit der URL [[url]] wurde empfangen",
          "nl": "Een [[method]]-verzoek ontvangen op url [[url]]"
        },
        "args": [
          {
            "type": "text",
            "name": "url",
            "placeholder": {
              "en": "/test",
              "de": "/test",
              "nl": "/test"
            }
          },
          {
            "type": "dropdown",
            "name": "method",
            "values": [
              {
                "id": "get",
                "label": {
                  "en": "GET",
                  "de": "GET",
                  "nl": "GET"
                }
              },
              {
                "id": "post",
                "label": {
                  "en": "POST",
                  "de": "POST",
                  "nl": "POST"
                }
              },
              {
                "id": "put",
                "label": {
                  "en": "PUT",
                  "de": "PUT",
                  "nl": "PUT"
                }
              },
              {
                "id": "options",
                "label": {
                  "en": "OPTIONS",
                  "de": "OPTIONS",
                  "nl": "OPTIONS"
                }
              }
            ]
          }
        ],
        "tokens": [
          {
            "name": "url",
            "type": "string",
            "title": {
              "en": "URL",
              "de": "URL",
              "nl": "URL"
            }
          },
          {
            "name": "method",
            "type": "string",
            "title": {
              "en": "Method",
              "de": "Methode",
              "nl": "Methode"
            }
          },
          {
            "name": "body",
            "type": "string",
            "title": {
              "en": "Body",
              "de": "Inhalt",
              "nl": "Inhoud"
            }
          }
        ],
        "id": "local-api-request-received"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Respond with 200",
          "de": "Mit Status code 200 antworten",
          "nl": "Reageer met 200"
        },
        "hint": {
          "en": "Send an empty response with status OK (http 200)",
          "de": "Sende eine leere Antwort mit den Status OK (http 200)",
          "nl": "Stuur een lege reactie met status OK (http 200)"
        },
        "id": "local-api-respond-with-200"
      },
      {
        "title": {
          "en": "Respond with...",
          "de": "Anworte mit...",
          "nl": "Reageer met..."
        },
        "titleFormatted": {
          "en": "Respond with [[body]] JSON.",
          "de": "Antworte mit [[body]] JSON.",
          "nl": "Reageer met [[body]] JSON."
        },
        "hint": {
          "en": "Personalize the response object",
          "de": "Personalisieren das Antwortobject",
          "nl": "Personaliseer het antwoordobject"
        },
        "args": [
          {
            "type": "text",
            "name": "body",
            "placeholder": {
              "en": "Body JSON response",
              "de": "JSON Antwort",
              "nl": "JSON-antwoord"
            }
          }
        ],
        "id": "local-api-response-with"
      }
    ]
  }
}